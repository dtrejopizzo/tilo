# Copiá este archivo a .env.local (desarrollo) y cargá los mismos valores en Vercel → Settings → Environment Variables.

# URL pública de la app (sin barra final). En desarrollo: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://tu-tilo.vercel.app

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de tokens OAuth y API keys propias (32 bytes en base64): openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google OAuth client (el mismo que usa Supabase para el login): Gmail, Calendar y Google Health
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Strava → https://www.strava.com/settings/api (Authorization Callback Domain: tu dominio)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Cualquier texto secreto; se usa al suscribir el webhook de Strava (ver integrations/README.md)
STRAVA_WEBHOOK_VERIFY_TOKEN=

# IA de Tilo (tier pago de Gemini: los datos de usuarios no se usan para entrenar)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Pedidos de IA por día durante la prueba gratis de 7 días
AI_FREE_DAILY_REQUESTS=30

# Vercel Cron manda "Authorization: Bearer $CRON_SECRET" a /api/cron/daily; el sync cada 15 min
# (Supabase pg_cron o GitHub Actions, ver DEPLOY.md) usa el mismo secreto: openssl rand -hex 24
CRON_SECRET=

# Google Health en tiempo real (opcional, ver integrations/README.md). El secreto va como header
# Authorization en cada notificación: "Bearer " + openssl rand -hex 24
GOOGLE_HEALTH_WEBHOOK_SECRET=
