{
  "name": "tilo-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for Tilo: tasks, habits, water, meals and weight from any MCP client",
  "type": "module",
  "bin": {
    "tilo-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6",
    "@tilo/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  }
}
