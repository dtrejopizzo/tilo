{
  "name": "tilo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/mcp",
    "integrations/vscode"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm test -w packages/core && npm run test:db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:mcp": "npm run build -w integrations/mcp",
    "build:vscode": "npm run build -w integrations/vscode",
    "db:seed-exercises": "tsx scripts/gen-exercise-seed.ts",
    "db:setup-sql": "tsx scripts/build-setup-sql.ts",
    "health:webhook": "tsx scripts/google-health-webhook.ts",
    "test:db": "vitest run --root supabase",
    "db:migrate-firebase": "tsx scripts/migrate-firestore.ts",
    "demo": "NEXT_PUBLIC_DEMO=true NEXT_PUBLIC_SUPABASE_URL=https://demo.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=demo npm run dev -w apps/web"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "typescript": "~5.8.2",
    "firebase-admin": "^13.10.0",
    "@supabase/supabase-js": "^2.75.0"
  }
}
